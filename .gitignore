# Python / Node environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
npm-debug.log*
# The audit venv is separate from .venv-desktop; `.venv/` does not match it, and
# a bare `git add -A` used to stage ~1200 site-packages files because of that.
/.venv-audit/

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent and browser automation state
.planning/
.playwright-cli/
.agent/
.agents/

# Archived stale source snapshots. Kept on disk for provenance but deliberately
# untracked: they are same-named copies of live source, so tracking them made
# `git grep subtitle_pipeline.py` return eight contradictory answers when only
# one of them is the code that runs.
/.archive/

# Maintainer working notes stay on the maintainer's machine. The repository
# publishes only user and contributor documentation; everything else under
# docs/ (plans, handoffs, investigation reports, session notes, research) is
# ignored by default, so a new note cannot be committed by accident.
/docs/*
!/docs/README.md
!/docs/DEVELOPMENT.md
!/docs/PROVIDERS.md
!/docs/ASR-COMPATIBILITY.md
!/docs/RELEASING.md
!/docs/architecture.md
!/docs/security.md
!/docs/en/
!/docs/zh-CN/
!/docs/ja/
!/docs/de/
!/docs/ru/
!/docs/assets/
/CONTEXT.md
/*_handoff.md
/Start-Subtitle-Optimized.cmd

# yt-dlp.exe is fetched by scripts/fetch-yt-dlp.py (pinned in
# desktop/dependencies.json), not committed.
/prototype/hls-companion/vendor/yt-dlp/yt-dlp.exe
/prototype/hls-companion/vendor/yt-dlp/yt-dlp
/prototype/hls-companion/vendor/yt-dlp/yt-dlp.download

# Generated reports, benchmarks, recordings, media and logs
output/
stream/
logs/
cache/
captures/
live-delay-*.json
*.log
*.m3u8
*.m4s
*.mp4
*.webm
*.wav
*.pcm
# Scratch space: probe scripts, experiment output, model checkpoints, captures.
# Nothing here is needed to build or run the project, and it is where the bulk
# lives (checkpoints alone reached 486 MB). The durable records that used to sit
# here — investigation reports, specs, the per-session logs — were moved to
# docs/notes/ (local-only, see above) so `rm -rf .scratch` cannot lose them.
#
# Note this also covers the MPEG-TS captures that once made `guard:release` fail
# (five committed .ts files from the 2026-09-09 startup-sync experiment).
/.scratch/
prototype/hls-companion/.benchmark-data/
prototype/hls-companion/benchmark-results/
prototype/hls-companion/runtime-*/

# Companion runtime: provider keys, Cookie snapshots, control secret, media and caches
prototype/hls-companion/runtime/**
!prototype/hls-companion/runtime/providers.example.json
# Same thing one directory up: `prototype/runtime/providers.json` belongs to the
# older delayed_live_player entry point and holds this machine's provider
# selection. Nothing references it any more, and it sat outside the rule above,
# so it was one `git add -A` away from being published. (Its apiKey field is
# currently empty and translation uses apiKeyEnv, but that is not a guarantee.)
prototype/runtime/

# Disproved/unused local downloader and model experiments
prototype/hls-companion/vendor/n-m3u8dl-re/
prototype/hls-companion/vendor/models/

# Local configuration and credentials
.env
.env.*
!.env.example
*.local.json
*.secret
*.cookies
cookies.txt

# Ad-hoc probe/start payloads written to the repo root while debugging a live
# session. They are per-run scratch, not fixtures.
/probe*.json
/start*.json
/*.tmp
# Windows ReplaceFile leftovers (`index.html~RF68e9c480.TMP`). An interrupted
# editor/tool save leaves one next to the real file, and it then gets copied
# into the packaged build by the freeze.
*~RF*.TMP
# Windows reserved device name; cannot be a real tracked file.
/nul

# Desktop build environments and distributable artifacts
/.venv-desktop/
/build-desktop/
/release/
/release-*/
/.smoke-*/
